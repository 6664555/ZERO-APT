# ZERO-APT environment configuration template
# Copy this file to .env and fill in your own values. Never commit .env.

# ---- LLM backend (utils/llm.py) ----
# Required for real runs; dry-run uses LLM_TYPE=mock. See also main.py/README.
DEEPSEEK_API_KEY=sk-your-deepseek-key
CLAUDE_API_KEY=sk-your-claude-key
LLM_TYPE=deepseek
# Claude is reached via an OpenAI-compatible gateway (Anthropic's native API is not
# OpenAI-compatible). Configure your gateway endpoint and model name:
# CLAUDE_BASE_URL=https://your-openai-compatible-gateway/v1
# CLAUDE_MODEL=claude-opus-4-6  # change to any OpenAI-compatible model name

# ---- Attack target (main.py, executor/run_atomics.py) ----
TARGET_HOSTNAME=TARGET
TARGET_IP=192.168.1.100
TARGET_OS=windows server 2022
TARGET_USER=User1
TARGET_PASSWORD=your-password
TARGET_ADMIN_USER=Administrator
# Optional per-run mission override; otherwise the scenario mission is used
# MISSION=Extract local credentials on the target

# ---- Defender log source (utils/monitor_tools.py) ----
# Elasticsearch endpoint queried for Sysmon winlogbeat-* indices
ELASTICSEARCH_URL=http://localhost:9200

# ---- Environment reset (utils/snapshot.py, optional) ----
# VMware snapshot tool paths for per-experiment environment reset
# VMWARE_RUN=D:\Program Files (x86)\VMware\VMware Workstation\vmrun.exe
# VMX_PATH=D:\Users\you\Documents\Virtual Machines\WindowsServer 2022\WindowsServer 2022.vmx

# ---- Output format (agents/purple.py) ----
# Post-hoc CTI report format: markdown (default, .md only) | stix (.stix.json only) | both.
# 'stix'/'both' require `pip install stix2`.
CTI_FORMAT=markdown
